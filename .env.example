# ─────────────────────────────────────────────────────────────
# ballute-studio 환경변수 템플릿
# ─────────────────────────────────────────────────────────────
# 새 PC에서 셋업 시 .env.local 만들거나 백업 복원.
# 실제 키는 1Password / 외장하드 / 보안 백업에 보관.
#
# 사용:
#   cp .env.example .env.local
#   # → .env.local 열어서 실제 값으로 채우기

# ─── Google Gemini AI (이미지 생성) ──────────────────────────
GEMINI_API_KEY=""

# ─── Supabase (인증 / DB) ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Toss Payments (결제) ────────────────────────────────────
NEXT_PUBLIC_TOSS_CLIENT_KEY=""
TOSS_SECRET_KEY=""

# ─── Cron 보호 ───────────────────────────────────────────────
CRON_SECRET=""

# ─── Google Cloud (Vertex AI / Storage) ──────────────────────
GOOGLE_GENAI_USE_VERTEXAI="false"
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="asia-northeast3"
GOOGLE_APPLICATION_CREDENTIALS=""

# ─── GCS (이미지 저장소) ─────────────────────────────────────
GCP_PROJECT_ID=""
GCS_BUCKET_NAME=""
GCS_BUCKET_REGION="asia-northeast3"
# 서비스 계정 JSON 파일 경로 — Mac/WSL2/Windows 서로 다름
GCS_SERVICE_ACCOUNT_KEY_FILE=""

# ─── fal.ai (영상/이미지 생성, 선택) ──────────────────────────
FAL_KEY=""
