# Mac / Linux / WSL2 / Windows 모두에서 줄바꿈을 LF로 통일.
# Windows에서 git clone 시 CRLF로 자동 변환되는 거 방지.

# 텍스트 파일 전부 LF
* text=auto eol=lf

# 명시적으로 LF 보장
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
*.env       text eol=lf
.gitignore  text eol=lf

# 바이너리 파일 (변환 X)
*.jpg       binary
*.jpeg      binary
*.png       binary
*.gif       binary
*.webp      binary
*.ico       binary
*.svg       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary
*.pdf       binary
*.zip       binary
